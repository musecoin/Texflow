# --- Database -------------------------------------------------------------
# Schema owner (migrations only). In production use a dedicated owner role, not a superuser.
DATABASE_URL=postgres://postgres:postgres_dev_only@127.0.0.1:5432/texflow
# Least-privilege runtime role (no table ownership, no BYPASSRLS). Role name must be texflow_app.
APP_DATABASE_URL=postgres://texflow_app:app_dev_only@127.0.0.1:5432/texflow
# Tests use a separate database so they never touch dev data.
TEST_DATABASE_URL=postgres://postgres:postgres_dev_only@127.0.0.1:5432/texflow_test
TEST_APP_DATABASE_URL=postgres://texflow_app:app_dev_only@127.0.0.1:5432/texflow_test

# --- API ------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
# Comma separated list of allowed browser origins (CORS). Capacitor Android uses https://localhost
CORS_ORIGINS=http://localhost:8080,https://localhost,capacitor://localhost
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_RATE_LIMIT_PER_MIN=10
API_RATE_LIMIT_PER_MIN=600
# Seed password for DEMO users (dev only; never used in production)
DEMO_PASSWORD=Demo!2026

# --- Background jobs / storage / AI (Phase 4-5; not used by Phase 0 code) --
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=texflow-private
S3_ACCESS_KEY=
S3_SECRET_KEY=
AI_PROVIDER=none
AI_API_KEY=

# --- Backups --------------------------------------------------------------
BACKUP_DIR=./backups
# 32+ char passphrase for AES-256 encryption of pg_dump output
BACKUP_PASSPHRASE=

# --- AI document reading ("Fotoğraftan sipariş") — optional ---------------
# Without a key the feature is shown as disabled. Each read costs API usage.
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_RATE_PER_HOUR=30
